{
  "name": "waiter-shift-tracker",
  "version": "1.5.2",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start:dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@mantine/charts": "9.8.1",
    "@mantine/core": "9.8.1",
    "@mantine/dates": "9.8.1",
    "@mantine/form": "9.8.1",
    "@mantine/hooks": "9.8.1",
    "@mantine/notifications": "9.8.1",
    "@tabler/icons-react": "3.52.0",
    "dayjs": "1.11.23",
    "i18next": "26.2.0",
    "idb-keyval": "6.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.0.8",
    "react-router-dom": "7.18.5",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@cloudflare/vite-plugin": "1.69.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.6",
    "@vitest/ui": "4.1.6",
    "fake-indexeddb": "6.2.8",
    "happy-dom": "20.9.0",
    "husky": "9.1.7",
    "jsdom": "29.1.1",
    "postcss": "8.5.33",
    "postcss-preset-mantine": "1.18.0",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.6",
    "wrangler": "4.162.0"
  }
}
